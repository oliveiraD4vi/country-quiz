{
  "name": "country-quiz",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Quiz de países em português e inglês, solo ou em salas com amigos",
  "scripts": {
    "dev": "vite",
    "server": "node --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
